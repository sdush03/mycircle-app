{
  "expo": {
    "name": "Misty Visuals",
    "slug": "my-circle",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mycircle",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/logo-black.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "icon": "./assets/images/ios-icon.png",
      "bundleIdentifier": "com.mistyvisuals.mycircle",
      "supportsTablet": true,
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Allow Misty Visuals to save photos to your gallery.",
        "NSPhotoLibraryAddUsageDescription": "Allow Misty Visuals to save photos to your photo gallery.",
        "CFBundleURLTypes": [
          {
            "CFBundleURLSchemes": [
              "mycircle",
              "com.mistyvisuals.mycircle",
              "com.googleusercontent.apps.1051090030242-vhi0ec15ittd3ugik983p9gaohlr7fv4"
            ]
          },
          {
            "CFBundleURLSchemes": [
              "mycircle",
              "com.mistyvisuals.mycircle",
              "com.googleusercontent.apps.1051090030242-vhi0ec15ittd3ugik983p9gaohlr7fv4"
            ]
          }
        ],
        "ITSAppUsesNonExemptEncryption": false
      },
      "appleTeamId": "9S743W7CRJ"
    },
    "android": {
      "package": "com.mistyvisuals.mycircle",
      "versionCode": 5,
      "googleServicesFile": "./google-services.json",
      "splash": {
        "image": "./assets/images/splash-android-icon.png",
        "resizeMode": "contain",
        "backgroundColor": "#ffffff"
      },
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-media-library",
        {
          "photosPermission": "Allow Misty Visuals to save photos to your gallery.",
          "savePhotosPermission": "Allow Misty Visuals to save photos to your gallery."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#ffffff",
          "image": "./assets/images/logo-black.png",
          "imageWidth": 160,
          "resizeMode": "contain"
        }
      ],
      "expo-secure-store",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.1051090030242-vhi0ec15ittd3ugik983p9gaohlr7fv4"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow My Circle to access your camera to take a live selfie for facial recognition.",
          "microphonePermission": false
        }
      ],
      "expo-asset",
      "expo-web-browser",
      "expo-font",
      "expo-apple-authentication",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.4",
            "useFrameworks": "static",
            "modularHeaders": [
              "GoogleUtilities",
              "RecaptchaInterop"
            ]
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "0e3ae02b-253b-4061-b328-0ea03b9e7308"
      }
    }
  }
}
